[Unit]
Description=SecondLook API
After=network-online.target docker.service

[Service]
User=linux1
WorkingDirectory=/home/linux1/secondlook
EnvironmentFile=/home/linux1/secondlook/.api.env
ExecStart=/home/linux1/secondlook/.venv/bin/uvicorn src.api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
